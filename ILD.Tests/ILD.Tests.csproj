<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.Sinks.InMemory" Version="2.0.0" />
    <!--
      Microsoft.Data.Sqlite.Core drags in SQLitePCLRaw 2.1.11, whose bundled
      e_sqlite3 build carries GHSA-2m69-gcr7-jv3q and has no patched 2.x. The
      3.x bundle ships SQLite 3.53.4 instead, so name it directly here and let
      nearest-wins lift the whole SQLitePCLRaw graph out of the advisory.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The API only wires up static files and the SPA fallback when a wwwroot sits
    next to the entry assembly. Shipping this stand-in to the test output makes
    that branch live for every host an integration test boots, so the pipeline
    under test has the same shape as the one in the container.
  -->
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ILD.Core\ILD.Core.csproj" />
    <ProjectReference Include="..\ILD.Api\ILD.Api.csproj" />
    <ProjectReference Include="..\ILD.Data\ILD.Data.csproj" />
    <ProjectReference Include="..\ILD.WorkItemServer\ILD.WorkItemServer.csproj" />
    <ProjectReference Include="..\ILD.McpServer\ILD.McpServer.csproj" />
  </ItemGroup>

</Project>