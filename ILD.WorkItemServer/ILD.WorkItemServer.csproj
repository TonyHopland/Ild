<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ReadyToRunPublish>false</ReadyToRunPublish>
    <RootNamespace>ILD.WorkItemServer</RootNamespace>
    <StartupObject>ILD.WorkItemServer.WorkItemServerProgram</StartupObject>
    <DefineConstants>$(DefineConstants);WORKITEM_SERVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- Pin the transitive Microsoft.OpenApi to the latest 2.x: versions before 2.7.5
         carry GHSA-v5pm-xwqc-g5wc, and Microsoft.AspNetCore.OpenApi 10 requires
         [2.12.0, 3.0.0), which rules out 3.x. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="data\runtime\**\*.cs" />
    <Compile Include="..\ILD.Data\NpgsqlPoolDefaults.cs" Link="NpgsqlPoolDefaults.cs" />
    <Compile Include="..\ILD.Data\Backup\ArchiveManifest.cs" Link="Backup\ArchiveManifest.cs" />
    <Compile Include="..\ILD.Data\Backup\BackupRefusedException.cs" Link="Backup\BackupRefusedException.cs" />
    <Compile Include="..\ILD.Data\Backup\ForwardOnlyStream.cs" Link="Backup\ForwardOnlyStream.cs" />
    <Compile Include="..\ILD.Data\Backup\FramedStreams.cs" Link="Backup\FramedStreams.cs" />
    <Compile Include="..\ILD.Data\Backup\IDatabaseArchive.cs" Link="Backup\IDatabaseArchive.cs" />
    <Compile Include="..\ILD.Data\Backup\PostgresDatabaseArchive.cs" Link="Backup\PostgresDatabaseArchive.cs" />
    <Content Remove="data\runtime\**\*" />
    <None Remove="data\runtime\**\*" />
  </ItemGroup>

</Project>
