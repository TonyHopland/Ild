<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ReadyToRunPublish>false</ReadyToRunPublish>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.7" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ILD.Data\ILD.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The uid-isolation decisions in WorktreePreviewService (which uid a preview
         command crosses to, which HOME its npm prefix follows) can only be observed
         end-to-end by actually running a setpriv uid switch, which needs CAP_SETUID
         and CAP_SETGID and a second uid: no test host has them. Asserting the
         constructed ProcessStartInfo instead is what keeps them covered, and it is
         strictly more precise than intercepting the spawn, since it also sees the
         absolute setpriv path. Nothing production-facing is widened here;
         AgentIsolation itself stays public. -->
    <InternalsVisibleTo Include="ILD.Tests" />
  </ItemGroup>

</Project>
