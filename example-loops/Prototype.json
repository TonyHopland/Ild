{
  "$schema": "ild-loop-template/v2",
  "name": "Prototype",
  "description": "Plan a prototype -> set up a preview (ild.config.json) if needed -> build it -> refine it with the human in a live preview -> open a PR, or finish once the work is captured in work items.",
  "recoveryPolicy": "AutoResume",
  "nodes": [
