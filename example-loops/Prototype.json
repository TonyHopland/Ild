        "toolAllowlist": [
          "read",
          "execute",
          "ild"
        ],
        "matchRules": [
          {
            "pattern": "(?m)^[*`\\s]*PLAN_READY([^\\w]|$)",
            "edgeName": "plan_ready"
          },
          {
            "pattern": "(?m)^[*`\\s]*NEEDS_HUMAN([^\\w]|$)",
            "edgeName": "needs_human"
          }
        ],
        "outputs": [
          {
            "name": "OnSuccess"
          },
          {
            "name": "OnFailure"
          },
          {
            "name": "plan_ready"
          },
          {
            "name": "needs_human"
          }
        ]
      }
    }
