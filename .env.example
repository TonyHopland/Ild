ILD_USERNAME=admin
ILD_PASSWORD=your-secure-password-here
ILD_LOG_LEVEL=Warning
# Log level for the WorkItem Server console; defaults to ILD_LOG_LEVEL.
# WORKITEM_LOG_LEVEL=
# Agent commits default to your host ~/.gitconfig (mounted read-only). Point
# GIT_CONFIG at a different file, or override the identity by uncommenting the
# lines below. Author and committer are independent: set both pairs to the same
# value for one identity, or to different values (e.g. you as author, a bot as
# committer). Any pair you leave unset falls back to the host .gitconfig.
GIT_CONFIG=~/.gitconfig
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com
# Shared secret between the ILD app and the WorkItem Server. REQUIRED — there is
# no default. Generate a strong value, e.g.: openssl rand -hex 32
WORKITEM_API_KEYS=
# Encryption-at-rest key for provider API keys and webhook secrets stored in the
# database. Optional but strongly recommended for any non-local deployment. When
# unset, those secrets are stored in plaintext. Any non-empty string works; use a
# high-entropy value, e.g.: openssl rand -hex 32
# WARNING: losing this key makes already-encrypted secrets unrecoverable — back it up.
ILD_SECRET_KEY=
# Keys the hash each session token is stored under, so a row in the sessions table
# cannot be forged by anything that can only write the database. REQUIRED under
# docker compose — there is no default. Setting or changing it re-addresses every
# session and so signs every device out once; losing it costs nothing but a
# re-login. Generate a strong value, e.g.: openssl rand -hex 32
ILD_SESSION_TOKEN_PEPPER=

# PostgreSQL passwords, one per role. REQUIRED — there are no defaults and docker
# compose refuses to start without them. Generate each separately, e.g.:
# openssl rand -hex 32
# These are written into the roles the FIRST time the postgres volume is created.
# Changing a value afterwards does not re-run that setup — ALTER ROLE the running
# database to match, or discard the volume.
POSTGRES_PASSWORD=
ILD_DB_PASSWORD=
WORKITEM_DB_PASSWORD=

# Base URL agents and the MCP server use to call back into the ILD API.
# ILD_API_URL=http://localhost:8080
# Work-item attachment sizes, in whole MB. Compose passes both to the ILD and
# the WorkItem Server containers, which enforce them independently.
# ILD_MAX_ATTACHMENT_MB=25
# ILD_MAX_ATTACHMENTS_TOTAL_MB=250
# Days a coding-agent release must have been published before ILD installs it
# automatically, 0 to 365 (0 installs the newest at once). Updates are always on;
# roll back or update by hand from the AI Providers page.
# ILD_AGENT_UPDATE_COOLDOWN_DAYS=1
# URL and API key used to auto-seed the global WorkItem Server connection.
# The API key defaults to WORKITEM_API_KEYS when unset.
# ILD_WORKITEM_SERVER_URL=http://workitem-server:8081
# ILD_WORKITEM_SERVER_API_KEY=
# Comma-separated CORS origins allowed to call the ILD API.
# ILD_ALLOWED_ORIGINS=
# Origin worktree previews are served under, on wildcard subdomains
# (wi-<workItemId>[-<serviceName>].<base>). Compose defaults it to
# http://ild.localhost:8080. A hostname with no running preview behind it answers
# 404, but a running preview IS UNAUTHENTICATED — uncomment the empty assignment
# below to turn preview proxying off entirely. See docs/deployment.md.
# ILD_PREVIEW_PROXY_BASE=http://ild.localhost:8080
# ILD_PREVIEW_PROXY_BASE=

WITH_CERTS=0

# AI provider CLIs send usage telemetry and other tracking calls home unless
# this is set. Setting it here puts it in front of every CLI installed onto
# /data, not just the ones this repo knows about — whether a given CLI then
# honours it is that CLI's own business, and some have a separate knob instead.
# To let them report as they normally would, blank this out (DO_NOT_TRACK=)
# rather than setting 0, which several CLIs read as "do not track" simply
# because the variable is there at all. A CLI that checks only for presence
# needs the line dropped from docker-compose.yml to be fully opted back in.
DO_NOT_TRACK=1

# PostgreSQL connection strings, only used when running the apps directly
# (docker compose sets its own connection strings and ignores these). Substitute
# the ILD_DB_PASSWORD / WORKITEM_DB_PASSWORD values set above — those are what the
# ild_core and ild_workitems roles were created with.
# ILD_DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=IldCore;Username=ild_core;Password=
# WORKITEM_DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=IldWorkitems;Username=ild_workitems;Password=

# Build-time toolchain versions. Use a specific tag (e.g. 26-alpine, 10.0)
# or "latest" to pull the newest image / channel.
NODE_VERSION=26-alpine
DOTNET_VERSION=10.0
# The Node ILD's image installs coding agents with. Set to "latest" to fetch the
# newest available.
NODE_RUNTIME_VERSION=26.13.0
# npm installed over the one Node ships. An exact version
# (no ranges or "latest"): the build checks npm reports exactly this. An empty
# value keeps the npm bundled with Node.
NPM_VERSION=12.2.1

# Set WITH_CERTS=1 and place .crt or .pem files in the local certs/ directory
# before running docker compose build to bake custom CA certificates into the
# image. The certs/ directory is gitignored so certificates are never committed.

# Required. Each loop run, chat and provider sign-in runs in a container of its
# own, on the engine compose talks to. Its socket, as the machine the containers
# run on sees it; whoever holds it controls that engine.
#   Rootless Podman on Linux      /run/user/<uid>/podman/podman.sock
#   Podman machine, rootless      /run/user/1000/podman/podman.sock
#   Podman machine, rootful       /run/podman/podman.sock
#   Rootful Podman on Linux       /run/podman/podman.sock  (also set
#                                 ILD_CONTAINER_SOCKET_GRANT=1 below)
#   Rootful Docker                /var/run/docker.sock
ILD_CONTAINER_SOCKET_HOST=
# A socket of the host's root group (rootful Podman on Linux; a Podman machine's
# is root:wheel and needs nothing) is one ILD does not join. 1 lets ILD's
# entrypoint give it the group below each time ILD starts, so an engine or
# machine restart needs nothing from you. ILD is then root-equivalent on that
# machine; runs and chats still never get the socket.
# ILD_CONTAINER_SOCKET_GRANT=1
# The gid that group has (default 10099). The host sees the socket under it, so
# pick a gid nothing on the host uses; not 0 and not ILD's own 10001.
# ILD_CONTAINER_SOCKET_GID=10099
# What a run's container may use; 0 is no limit, for a rootless engine whose
# cgroup controllers are not delegated.
# ILD_RUN_CPU_LIMIT=4
# ILD_RUN_MEMORY_LIMIT=8Gi
